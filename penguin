cat > game.py << 'EOF'
import pygame

pygame.init()
pygame.mixer.init()

WIDTH, HEIGHT = 600, 400
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Penguin Run")

GROUND_Y = 320

# Colors
SKY_BLUE = (135, 206, 235)
GROUND_GREEN = (80, 180, 80)
OBSTACLE_RED = (200, 60, 60)
FLAG_GOLD = (255, 215, 0)
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
BUTTON_BLUE = (70, 130, 220)
BUTTON_HOVER = (100, 160, 250)

player_size = 50
player_speed = 5
GRAVITY = 0.8
JUMP_STRENGTH = -15

class Enemy:
    def __init__(self, x, y, size, left_bound, right_bound, speed):
        self.rect = pygame.Rect(x, y, size, size)
        self.left_bound = left_bound
        self.right_bound = right_bound
        self.speed = speed
        self.direction = 1

    def update(self):
        self.rect.x += self.speed * self.direction
        if self.rect.left <= self.left_bound:
            self.direction = 1
        if self.rect.right >= self.right_bound:
            self.direction = -1

    def get_image(self):
        return crab_right if self.direction == 1 else crab_left

# ---- LEVEL DEFINITIONS ----
LEVELS = [
    {
        "width": 3000,
        "music": "level1_music.wav",
        "obstacles": [
            (500, GROUND_Y - 40, 30, 40),
            (800, GROUND_Y - 40, 30, 40),
            (1400, GROUND_Y - 40, 30, 40),
            (2000, GROUND_Y - 60, 30, 60),
            (2600, GROUND_Y - 40, 30, 40),
        ],
        "enemies": [
            (1000, GROUND_Y - 40, 40, 950, 1250, 2),
            (1700, GROUND_Y - 40, 40, 1650, 1950, 3),
            (2300, GROUND_Y - 40, 40, 2250, 2550, 2),
        ],
    },
    {
        "width": 3600,
        "music": "level2_music.wav",
        "obstacles": [
            (400, GROUND_Y - 40, 30, 40),
            (700, GROUND_Y - 60, 30, 60),
            (1000, GROUND_Y - 40, 30, 40),
            (1600, GROUND_Y - 40, 30, 40),
            (1900, GROUND_Y - 60, 30, 60),
            (2400, GROUND_Y - 40, 30, 40),
            (2800, GROUND_Y - 60, 30, 60),
            (3200, GROUND_Y - 40, 30, 40),
        ],
        "enemies": [
            (600, GROUND_Y - 40, 40, 550, 900, 3),
            (1300, GROUND_Y - 40, 40, 1250, 1550, 3),
            (2100, GROUND_Y - 40, 40, 2050, 2350, 4),
            (2900, GROUND_Y - 40, 40, 2850, 3150, 4),
        ],
    },
]

current_level = 0
obstacles = []
enemies = []
LEVEL_WIDTH = 0
finish_line = None
player_rect = pygame.Rect(100, GROUND_Y - player_size, player_size, player_size)
vel_y = 0
on_ground = False

def load_level(index):
    global obstacles, enemies, LEVEL_WIDTH, finish_line, vel_y, on_ground
    level = LEVELS[index]
    LEVEL_WIDTH = level["width"]

    pygame.mixer.music.load(level["music"])
    pygame.mixer.music.play(-1)

    obstacles = [pygame.Rect(*o) for o in level["obstacles"]]
    enemies = [Enemy(*e) for e in level["enemies"]]
    finish_line = pygame.Rect(LEVEL_WIDTH - 70, GROUND_Y - 100, 20, 100)
    player_rect.x = 100
    player_rect.y = GROUND_Y - player_size
    vel_y = 0
    on_ground = False

def play_menu_music():
    pygame.mixer.music.load("inicial.wav")
    pygame.mixer.music.play(-1)

# Load crab enemy image
enemy_size = 40
crab_image_raw = pygame.image.load("crab.png").convert_alpha()
crab_left = pygame.transform.scale(crab_image_raw, (enemy_size, enemy_size))
crab_right = pygame.transform.flip(crab_left, True, False)

# Load penguin spritesheet and walking frames
spritesheet = pygame.image.load("tux.png").convert_alpha()
frame_width = 32
frame_height = 32

def get_frame(col, row):
    rect = pygame.Rect(col * frame_width, row * frame_height, frame_width, frame_height)
    frame = spritesheet.subsurface(rect)
    return pygame.transform.scale(frame, (player_size, player_size))

frames_right = [get_frame(col, 0) for col in range(8)]
frames_left = [get_frame(col, 1) for col in range(8)]

facing = "right"
anim_index = 0
anim_timer = 0
anim_speed = 6

big_font = pygame.font.SysFont(None, 60)
font = pygame.font.SysFont(None, 44)
small_font = pygame.font.SysFont(None, 28)

clock = pygame.time.Clock()

# Button helper
def draw_button(text, center_x, center_y, mouse_pos):
    label = font.render(text, True, WHITE)
    padding_x, padding_y = 30, 15
    rect = pygame.Rect(0, 0, label.get_width() + padding_x * 2, label.get_height() + padding_y * 2)
    rect.center = (center_x, center_y)
    color = BUTTON_HOVER if rect.collidepoint(mouse_pos) else BUTTON_BLUE
    pygame.draw.rect(screen, color, rect, border_radius=8)
    screen.blit(label, (rect.centerx - label.get_width() // 2, rect.centery - label.get_height() // 2))
    return rect

# ---- GAME STATE ----
state = "start"   # "start", "playing", "level_complete", "finished"
play_menu_music()

running = True
while running:
    keys = pygame.key.get_pressed()
    mouse_pos = pygame.mouse.get_pos()
    mouse_clicked = False

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            mouse_clicked = True
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE and state == "playing" and on_ground:
                vel_y = JUMP_STRENGTH
                on_ground = False
            if event.key == pygame.K_r:
                state = "start"
                current_level = 0
                play_menu_music()

    # ---- STATE: START SCREEN ----
    if state == "start":
        screen.fill(SKY_BLUE)
        title = big_font.render("Penguin Run", True, BLACK)
        screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 100))
        btn = draw_button("Start", WIDTH // 2, 220, mouse_pos)
        if mouse_clicked and btn.collidepoint(mouse_pos):
            current_level = 0
            load_level(current_level)
            state = "playing"

    # ---- STATE: PLAYING ----
    elif state == "playing":
        dx = 0
        if keys[pygame.K_LEFT]:
            dx = -player_speed
            facing = "left"
        if keys[pygame.K_RIGHT]:
            dx = player_speed
            facing = "right"

        is_moving = dx != 0

        player_rect.x += dx
        player_rect.x = max(0, min(player_rect.x, LEVEL_WIDTH - player_size))

        vel_y += GRAVITY
        player_rect.y += vel_y

        if player_rect.bottom >= GROUND_Y:
            player_rect.bottom = GROUND_Y
            vel_y = 0
            on_ground = True
        else:
            on_ground = False

        for enemy in enemies:
            enemy.update()

        for obs in obstacles:
            if player_rect.colliderect(obs):
                load_level(current_level)

        for enemy in enemies:
            if player_rect.colliderect(enemy.rect):
                load_level(current_level)

        if finish_line and player_rect.colliderect(finish_line):
            play_menu_music()
            if current_level < len(LEVELS) - 1:
                state = "level_complete"
            else:
                state = "finished"

        if is_moving:
            anim_timer += 1
            if anim_timer >= anim_speed:
                anim_timer = 0
                anim_index = (anim_index + 1) % 8
        else:
            anim_index = 0

        player_image = frames_left[anim_index] if facing == "left" else frames_right[anim_index]

        camera_x = player_rect.centerx - WIDTH // 2
        camera_x = max(0, min(camera_x, LEVEL_WIDTH - WIDTH))

        screen.fill(SKY_BLUE)
        pygame.draw.rect(screen, GROUND_GREEN, (0, GROUND_Y, WIDTH, HEIGHT - GROUND_Y))

        for obs in obstacles:
            pygame.draw.rect(screen, OBSTACLE_RED, (obs.x - camera_x, obs.y, obs.width, obs.height))

        for enemy in enemies:
            screen.blit(enemy.get_image(), (enemy.rect.x - camera_x, enemy.rect.y))

        pygame.draw.rect(screen, FLAG_GOLD, (finish_line.x - camera_x, finish_line.y, finish_line.width, finish_line.height))

        screen.blit(player_image, (player_rect.x - camera_x, player_rect.y))

        hint = small_font.render(f"Level {current_level + 1}/{len(LEVELS)} — Arrows to move, SPACE to jump, R to restart", True, BLACK)
        screen.blit(hint, (10, 10))

    # ---- STATE: LEVEL COMPLETE ----
    elif state == "level_complete":
        screen.fill(SKY_BLUE)
        msg = font.render(f"Level {current_level + 1} Complete!", True, BLACK)
        screen.blit(msg, (WIDTH // 2 - msg.get_width() // 2, 120))
        btn = draw_button("Next Level", WIDTH // 2, 220, mouse_pos)
        if mouse_clicked and btn.collidepoint(mouse_pos):
            current_level += 1
            load_level(current_level)
            state = "playing"

    # ---- STATE: FINISHED ----
    elif state == "finished":
        screen.fill(SKY_BLUE)
        msg = big_font.render("You Win!", True, BLACK)
        screen.blit(msg, (WIDTH // 2 - msg.get_width() // 2, 120))
        btn = draw_button("Play Again", WIDTH // 2, 220, mouse_pos)
        if mouse_clicked and btn.collidepoint(mouse_pos):
            state = "start"
            current_level = 0
            play_menu_music()

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
EOF
